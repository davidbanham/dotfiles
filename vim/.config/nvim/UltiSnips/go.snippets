snippet wtf "debug multiple values" b
log.Println("DEBUG$2", "$1", `!p
vars = [v.strip() for v in t[1].split(',')]
if len(vars) == 1:
	snip.rv = ', '.join([f"fmt.Sprintf(\`|%+v|\`, {v})" for v in vars if v])
else:
	snip.rv = ', '.join([f"fmt.Sprintf(\`|{v}: %+v|\`, {v})" for v in vars if v])
`);
endsnippet

snippet rwe "return wrapped error"
return ${3}fmt.Errorf("${1:message}: %w", ${2:err});
endsnippet
